<Window x:Class="Iron.Agent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iron Agent - Local Desktop AI Agent"
        Height="600" Width="900"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    
    <Grid Background="{StaticResource PrimaryColor}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <Border Grid.Column="0" Background="{StaticResource SurfaceColor}" BorderBrush="#2a2a4e" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Margin="15">
                    <TextBlock Text="IRON AGENT" Foreground="{StaticResource AccentColor}" 
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />
                    <TextBlock Text="Local Desktop AI" Foreground="{StaticResource MutedTextColor}" 
                               FontSize="11" Margin="0,0,0,20" />
                    
                    <StackPanel>
                        <TextBlock Text="TASKS" Foreground="{StaticResource MutedTextColor}" 
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,8" />
                        <ListBox x:Name="TaskList" BorderThickness="0" Background="Transparent" 
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Row="2" Margin="15" VerticalAlignment="Bottom">
                    <Button Content="New Chat" Click="NewChat_Click" 
                            Background="{StaticResource AccentColor}" Foreground="White" 
                            BorderThickness="0" Padding="10,6" FontSize="12" Margin="0,0,0,10" />
                    <Button Content="Settings" Click="Settings_Click" 
                            Background="Transparent" Foreground="{StaticResource MutedTextColor}" 
                            BorderBrush="{StaticResource MutedTextColor}" BorderThickness="1" 
                            Padding="10,6" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>
        
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <ScrollViewer x:Name="ChatScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" 
                          Padding="20" Background="{StaticResource PrimaryColor}">
                <ItemsControl x:Name="ChatMessages" BorderThickness="0" />
            </ScrollViewer>
            
            <StackPanel x:Name="TypingIndicator" Grid.Row="0" VerticalAlignment="Bottom" 
                        HorizontalAlignment="Left" Margin="60,0,0,80" Orientation="Horizontal"
                        Visibility="Collapsed">
                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentColor}" Margin="2">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Ellipse.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.6" AutoReverse="True" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentColor}" Margin="2">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Ellipse.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentColor}" Margin="2">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Ellipse.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.4" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
            </StackPanel>
            
            <Border Grid.Row="1" Background="{StaticResource SurfaceColor}" BorderBrush="#2a2a4e" BorderThickness="0,1,0,0">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="InputBox" Background="{StaticResource PrimaryColor}" 
                             Foreground="White" BorderBrush="#2a2a4e" BorderThickness="1" 
                             Padding="12,10" FontSize="13" VerticalAlignment="Center"
                             KeyDown="InputBox_KeyDown" />
                    
                    <Button x:Name="SendButton" Grid.Column="1" Content="Send" Click="SendButton_Click" 
                            Background="{StaticResource AccentColor}" Foreground="White" 
                            BorderThickness="0" Padding="20,10" FontSize="13" Margin="10,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
