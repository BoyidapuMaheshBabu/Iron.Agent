<Window x:Class="Iron.Agent.App.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iron Agent Pet"
        Height="150" Width="150"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonDown="Window_MouseRightButtonDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" BlurRadius="15" ShadowDepth="3" Opacity="0.4" />
    </Window.Resources>
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Show Main Window" Click="ShowMainWindow_Click" />
            <MenuItem Header="Settings" Click="Settings_Click" />
            <Separator />
            <MenuItem Header="Exit" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>
    <Grid>
        <Border CornerRadius="75" Background="#1a1a2e" Opacity="0.95" Width="150" Height="150"
                Effect="{StaticResource DropShadowEffect}">
            <Grid>
                <!-- Face -->
                <Ellipse Fill="#e94560" Width="90" Height="90" HorizontalAlignment="Center" VerticalAlignment="Center" />
                
                <!-- Eyes -->
                <Grid Width="90" Height="90" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="LeftEye" Fill="#ffffff" Width="14" Height="14" 
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="25,0,0,0" />
                    <Ellipse Fill="#000000" Width="6" Height="6" 
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0" />
                    <Ellipse x:Name="RightEye" Fill="#ffffff" Width="14" Height="14" 
                             HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,25,0" />
                    <Ellipse Fill="#000000" Width="6" Height="6" 
                             HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,30,0" />
                </Grid>
                
                <!-- Mouth -->
                <Path x:Name="Mouth" Stroke="#000000" StrokeThickness="3" 
                      Data="M 30,55 Q 45,65 60,55" 
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            
                <!-- State indicator -->
                <Ellipse x:Name="StateIndicator" Fill="#4cc9f0" Width="16" Height="16" 
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-5,-5,0,0" 
                         Opacity="0" />
                
                <!-- Speech bubble -->
                <Border x:Name="SpeechBubble" Background="#ffffff" CornerRadius="12" 
                        Width="0" Height="0" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,-40,0,0" Opacity="0" Visibility="Collapsed">
                    <TextBlock x:Name="SpeechText" Text="" Foreground="#1a1a2e" 
                               FontSize="11" FontWeight="SemiBold" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="10,6,10,6" TextWrapping="Wrap" MaxWidth="140" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
